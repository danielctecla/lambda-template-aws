# Copy to credentials.auto.tfvars (gitignored) and fill with the outputs of
# iac/bootstrap. Never commit the real file: ARNs contain your account ID.
deploy_role_arn          = "arn:aws:iam::<ACCOUNT_ID>:role/lambda-template-deployer"
permissions_boundary_arn = "arn:aws:iam::<ACCOUNT_ID>:policy/lambda-template-boundary"
